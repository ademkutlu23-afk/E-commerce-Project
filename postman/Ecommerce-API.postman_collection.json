{
  "info": {
    "name": "Workintech Ecommerce API",
    "description": "API requests used in the ecommerce project.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://workintech-fe-ecommerce.onrender.com"
    }
  ],
  "item": [
    {
      "name": "Get Roles",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/roles",
          "host": ["{{baseUrl}}"],
          "path": ["roles"]
        }
      }
    },
    {
      "name": "Signup Customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Customer\",\n  \"email\": \"change-this-customer@example.com\",\n  \"password\": \"Test123!\",\n  \"role_id\": 3\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/signup",
          "host": ["{{baseUrl}}"],
          "path": ["signup"]
        }
      }
    },
    {
      "name": "Signup Store",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Store Owner\",\n  \"email\": \"change-this-store@example.com\",\n  \"password\": \"Test123!\",\n  \"role_id\": 2,\n  \"store\": {\n    \"name\": \"Test Store\",\n    \"phone\": \"05551234567\",\n    \"tax_no\": \"T1234V123456\",\n    \"bank_account\": \"TR000000000000000000000000\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/signup",
          "host": ["{{baseUrl}}"],
          "path": ["signup"]
        }
      }
    }
  ]
}
